@model AdminLoginViewModel
@{
    ViewData["Title"] = "Admin sign in";
}

<section class="admin-page">
    <header class="admin-heading">
        <p class="admin-eyebrow">Bookstore administration</p>
        <h1>Sign in</h1>
    </header>

    <form method="post" asp-controller="Admin" asp-action="Login" class="admin-form">
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label asp-for="Password"></label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" autofocus />
        <span asp-validation-for="Password" class="field-validation"></span>
        <button type="submit" class="btn btn-primary">Sign in</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}